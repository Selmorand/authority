# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prompts
prompt.txt

# runtime data
data/memory.json
prisma/authority-os.db
prisma/authority-os.db-journal
backups/

# runtime user uploads (committed backgrounds live in public/backgrounds/)
/public/uploads/*
!/public/uploads/.gitkeep

# IDE
.vscode/*
!.vscode/settings.json
.idea/

# OS
Thumbs.db

# lock files are kept — do not ignore package-lock.json
.claude/

/lib/generated/prisma
