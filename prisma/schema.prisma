generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Mission Progress (persists status across navigations) ───

model MissionProgress {
  id        String   @id // matches mission id (e.g. "gen-2026-05-11-0" or cuid)
  date      String   // YYYY-MM-DD
  status    String   @default("pending") // pending | in-progress | completed
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ─── Mission Drafts (AI-generated execution output, cached per task) ──

model MissionDraft {
  // Stable key independent of ephemeral mission ids:
  //   reinforcement: "${date}-${reinforcementTopicId}"
  //   core asset:    "${date}-core-${topicId}"
  id             String   @id
  date           String   // YYYY-MM-DD of the day the draft was requested
  content        String   // the generated deliverable
  model          String   // model used (e.g. "claude-sonnet-4-6")
  targetUrl      String?  // the recommended URL to post/comment on (community-answer tasks)
  alternatesJson String?  // JSON array of { url, why } alternates
  searchQuery    String?  // the Tavily query used (for debugging / regeneration)
  videoUrl       String?  // rendered MP4 URL (caption-clip derivatives)
  videoProject   String?  // JSON2Video project id (for status polling)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
}

// ─── Missions ────────────────────────────────────────────────

model Mission {
  id             String   @id @default(cuid())
  date           String   // YYYY-MM-DD
  title          String
  category       String
  authorityFocus String
  platform       String
  estimatedTime  String
  objective      String
  topic          String
  description    String
  status         String   @default("pending") // pending | in-progress | completed
  priority       String   @default("medium") // high | medium | low
  themeId        String?
  contentAngle   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Strategic Memory ────────────────────────────────────────

model StrategicMemory {
  id              String   @id @default(cuid())
  date            String   // YYYY-MM-DD
  type            String   // completed-mission | successful-topic | authority-insight | content-performance | semantic-pattern | strategic-lesson
  theme           String   // theme id
  insight         String
  authorityImpact Int
  semanticValue   Int
  outcomeSummary  String
  strategicNotes  String
  category        String?
  platform        String?
  createdAt       DateTime @default(now())
}

// ─── Research Signals ────────────────────────────────────────

model ResearchSignal {
  id                   String   @id @default(cuid())
  title                String
  category             String   // trend | topic-shift | industry-observation | competitor-pattern | semantic-opportunity | authority-gap
  relevance            Int
  authorityOpportunity Int
  urgency              String   // high | medium | low
  relatedThemes        String   // JSON array of theme ids
  insightSummary       String
  suggestedActions     String   // JSON array of strings
  alertType            String
  dateDetected         String   // YYYY-MM-DD
  createdAt            DateTime @default(now())
}

// ─── Per-Platform Weekly Snapshot ────────────────────────────
// Normalized per-platform metrics. One row per (date, platform).
// date is the YYYY-MM-DD of the week (typically Monday) the row
// reports on.

model PlatformSnapshot {
  id          String   @id @default(cuid())
  date        String
  platform    String   // linkedin | x | facebook | instagram | tiktok | youtube | reddit | discord | blog
  followers   Int?
  impressions Int?
  engagement  Int?
  postsCount  Int?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, platform])
  @@index([date])
}

// ─── Authority Metrics ───────────────────────────────────────

model AuthoritySnapshot {
  id                      String   @id @default(cuid())
  date                    String   @unique // YYYY-MM-DD
  brandedSearchVolume     Int
  linkedinFollowers       Int
  linkedinPostImpressions Int
  publishedArticles       Int
  caseStudiesCompleted    Int
  externalMentions        Int
  backlinks               Int
  aiCitationOpportunities Int
  semanticThemesCovered   Int
  founderVisibilityScore  Int
  entityConsistencyScore  Int
  createdAt               DateTime @default(now())
}

// ─── External Corroboration ──────────────────────────────────

model ExternalCorroboration {
  id              String   @id @default(cuid())
  type            String   // mention | citation | guest-article | podcast | directory | partnership | backlink
  source          String
  title           String
  url             String?
  date            String   // YYYY-MM-DD
  authorityImpact Int
  relatedTheme    String
  createdAt       DateTime @default(now())
}

// ─── AI Visibility Checks ────────────────────────────────────

model AIVisibilityCheck {
  id              String   @id @default(cuid())
  runId           String?  // groups all checks from a single batch run (nullable for legacy seed rows)
  queryId         String?  // matches AIVisibilityQuery.id in data/aiVisibilityQueries.ts
  platform        String   // openai | anthropic | perplexity | google-ai-overview
  query           String   // the actual query text sent
  cited           Boolean
  position        Int?
  matchedBy       String?  // "url" | "text" | "both"
  citationsJson   String?  // JSON array of source URLs
  responseExcerpt String?  // first ~500 chars of the answer
  date            String
  theme           String?
  createdAt       DateTime @default(now())

  @@index([runId])
  @@index([date])
  @@index([queryId])
}

// ─── Executive Briefings ─────────────────────────────────────

model ExecutiveBriefing {
  id                       String   @id @default(cuid())
  date                     String   // YYYY-MM-DD
  authorityHealthScore     Int
  executionConsistencyScore Int
  aiVisibilityRate         Int
  semanticCoverage         Int
  momentumDirection        String
  whatMattersMost           String
  highestLeverageOpp       String
  biggestRisk              String
  recommendedFocus         String
  briefingSectionsJson     String   // JSON
  createdAt                DateTime @default(now())
}
