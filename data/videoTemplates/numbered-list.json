{
  "id": "numbered-list",
  "name": "Numbered List",
  "description": "Bold caption with a large step number in the top-left corner. Best for frameworks, checklists, step sequences. Lines are auto-numbered in order.",
  "orientation": "portrait",
  "width": 1080,
  "height": 1920,
  "movie": {
    "quality": "high",
    "cache": true
  },
  "defaults": {
    "backgroundColor": "#0F1216",
    "textColor": "#FFFFFF",
    "headlineColor": "#A5F3D4",
    "duration": 4
  },
  "sceneTemplate": {
    "duration": "{{duration}}",
    "background-color": "{{backgroundColor}}",
    "elements": [
      {
        "$when": "backgroundImageUrl",
        "type": "image",
        "src": "{{backgroundImageUrl}}",
        "position": "custom",
        "x": 0,
        "y": 0,
        "width": 1080,
        "height": 1920,
        "duration": "{{duration}}"
      },
      {
        "$when": "backgroundImageUrl",
        "type": "text",
        "text": " ",
        "position": "custom",
        "x": 0,
        "y": 0,
        "width": 1080,
        "height": 1920,
        "duration": "{{duration}}",
        "settings": {
          "background-color": "rgba(15,18,22,0.6)"
        }
      },
      {
        "type": "text",
        "text": "{{lineIndex}}",
        "position": "custom",
        "x": 80,
        "y": 150,
        "width": 220,
        "height": 220,
        "fade-in": 0.25,
        "fade-out": 0.3,
        "settings": {
          "font-family": "Inter",
          "font-size": "180px",
          "font-weight": "900",
          "font-color": "{{headlineColor}}",
          "text-align": "left",
          "vertical-position": "center"
        }
      },
      {
        "type": "text",
        "text": "{{line}}",
        "position": "custom",
        "x": 65,
        "y": 560,
        "width": 950,
        "height": 900,
        "fade-in": 0.4,
        "fade-out": 0.3,
        "settings": {
          "font-family": "Inter",
          "font-size": "92px",
          "font-weight": "700",
          "font-color": "{{textColor}}",
          "text-align": "center",
          "vertical-position": "center"
        }
      },
      {
        "$when": "headline",
        "type": "text",
        "text": "{{headline}}",
        "position": "custom",
        "x": 65,
        "y": 1725,
        "width": 950,
        "height": 80,
        "fade-in": 0.4,
        "fade-out": 0.3,
        "settings": {
          "font-family": "Inter",
          "font-size": "36px",
          "font-weight": "600",
          "font-color": "{{headlineColor}}",
          "text-align": "center",
          "vertical-position": "center"
        }
      }
    ]
  }
}
