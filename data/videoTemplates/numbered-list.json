{
  "id": "numbered-list",
  "name": "Numbered List",
  "description": "Bold caption with a large step number in the top-left corner. Best for frameworks, checklists, step sequences. Lines are auto-numbered in order.",
  "orientation": "portrait",
  "width": 1080,
  "height": 1920,
  "movie": {
    "quality": "high",
    "cache": true
  },
  "defaults": {
    "backgroundColor": "#0F1216",
    "textColor": "#FFFFFF",
    "headlineColor": "#A5F3D4",
    "duration": 4
  },
  "sceneTemplate": {
    "duration": "{{duration}}",
    "background-color": "{{backgroundColor}}",
    "elements": [
      {
        "type": "text",
        "text": "{{lineIndex}}",
        "position": "custom",
        "x": 80,
        "y": 150,
        "width": 220,
        "height": 220,
        "fade-in": 0.25,
        "fade-out": 0.3,
        "settings": {
          "font-family": "Inter",
          "font-size": "180px",
          "font-weight": "900",
          "font-color": "{{headlineColor}}",
          "text-align": "left",
          "vertical-position": "center"
        },
        "duration": -1
      },
      {
        "type": "text",
        "text": "{{line}}",
        "position": "custom",
        "x": 65,
        "y": 560,
        "width": 950,
        "height": 900,
        "fade-in": 0.4,
        "fade-out": 0.3,
        "settings": {
          "font-family": "Inter",
          "font-size": "92px",
          "font-weight": "700",
          "font-color": "{{textColor}}",
          "text-align": "center",
          "vertical-position": "center"
        },
        "duration": -1
      },
      {
        "$when": "headline",
        "type": "text",
        "text": "{{headline}}",
        "position": "custom",
        "x": 65,
        "y": 1725,
        "width": 950,
        "height": 80,
        "fade-in": 0.4,
        "fade-out": 0.3,
        "settings": {
          "font-family": "Inter",
          "font-size": "36px",
          "font-weight": "600",
          "font-color": "{{headlineColor}}",
          "text-align": "center",
          "vertical-position": "center"
        },
        "duration": -1
      },
      {
        "$when": "voiceText",
        "type": "voice",
        "text": "{{voiceText}}",
        "voice": "{{voiceName}}",
        "model": "{{voiceModel}}",
        "start": 0,
        "extra-time": 0.4,
        "duration": -1
      }
    ]
  }
}
