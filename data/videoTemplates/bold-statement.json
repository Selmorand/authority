{
  "id": "bold-statement",
  "name": "Bold Statement",
  "description": "One massive caption per scene — no brand stamp, no other elements. Pure caption. Best for high-impact 3-4 scene clips where the words ARE the visual.",
  "orientation": "portrait",
  "width": 1080,
  "height": 1920,
  "movie": {
    "quality": "high",
    "cache": true
  },
  "defaults": {
    "backgroundColor": "#0F1216",
    "textColor": "#FFFFFF",
    "headlineColor": "#A5F3D4",
    "duration": 4
  },
  "sceneTemplate": {
    "duration": "{{duration}}",
    "background-color": "{{backgroundColor}}",
    "elements": [
{
        "type": "text",
        "text": "{{line}}",
        "position": "custom",
        "x": 60,
        "y": 360,
        "width": 960,
        "height": 1200,
        "fade-in": 0.5,
        "fade-out": 0.4,
        "settings": {
          "font-family": "Inter",
          "font-size": "138px",
          "font-weight": "900",
          "font-color": "{{textColor}}",
          "text-align": "center",
          "vertical-position": "center",
          "line-height": "1.1"
        }
      },
      {
        "$when": "voiceText",
        "type": "voice",
        "text": "{{voiceText}}",
        "voice": "{{voiceName}}",
        "model": "{{voiceModel}}",
        "start": 0,
        "extra-time": 0.4
      }
    ]
  }
}
