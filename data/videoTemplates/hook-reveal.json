{
  "id": "hook-reveal",
  "name": "Hook → Reveal",
  "description": "Build suspense through the early scenes, then dramatise the final scene in accent colour. Best for engagement-driven shorts where you need watch-to-completion. Make the LAST line the payoff.",
  "orientation": "portrait",
  "width": 1080,
  "height": 1920,
  "movie": {
    "quality": "high",
    "cache": true
  },
  "defaults": {
    "backgroundColor": "#0F1216",
    "textColor": "#FFFFFF",
    "headlineColor": "#A5F3D4",
    "duration": 3.2
  },
  "sceneTemplate": {
    "duration": "{{duration}}",
    "background-color": "{{backgroundColor}}",
    "elements": [
      {
        "$when": "videoBackgroundUrl",
        "type": "video",
        "src": "{{videoBackgroundUrl}}",
        "position": "custom",
        "x": 0,
        "y": 0,
        "width": 1080,
        "height": 1920,
        "duration": "{{duration}}",
        "loop": true,
        "mute": true
      },
      {
        "$when": "backgroundImageUrl",
        "type": "image",
        "src": "{{backgroundImageUrl}}",
        "position": "custom",
        "x": 0,
        "y": 0,
        "width": 1080,
        "height": 1920,
        "duration": "{{duration}}",
        "zoom": 3
      },
      {
        "$when": "hasMediaBackground",
        "type": "text",
        "text": " ",
        "position": "custom",
        "x": 0,
        "y": 0,
        "width": 1080,
        "height": 1920,
        "duration": "{{duration}}",
        "settings": {
          "background-color": "rgba(15,18,22,0.6)"
        }
      },
      {
        "$when": "!isLast",
        "type": "text",
        "text": "{{line}}",
        "position": "custom",
        "x": 65,
        "y": 480,
        "width": 950,
        "height": 960,
        "fade-in": 0.3,
        "fade-out": 0.25,
        "settings": {
          "font-family": "Inter",
          "font-size": "92px",
          "font-weight": "600",
          "font-color": "{{textColor}}",
          "text-align": "center",
          "vertical-position": "center"
        }
      },
      {
        "$when": "isLast",
        "type": "text",
        "text": "{{line}}",
        "position": "custom",
        "x": 65,
        "y": 480,
        "width": 950,
        "height": 960,
        "fade-in": 0.6,
        "fade-out": 0.4,
        "settings": {
          "font-family": "Inter",
          "font-size": "126px",
          "font-weight": "900",
          "font-color": "{{headlineColor}}",
          "text-align": "center",
          "vertical-position": "center"
        }
      },
      {
        "$when": "headline",
        "type": "text",
        "text": "{{headline}}",
        "position": "custom",
        "x": 65,
        "y": 1725,
        "width": 950,
        "height": 80,
        "fade-in": 0.4,
        "fade-out": 0.3,
        "settings": {
          "font-family": "Inter",
          "font-size": "36px",
          "font-weight": "600",
          "font-color": "{{headlineColor}}",
          "text-align": "center",
          "vertical-position": "center"
        }
      },
      {
        "$when": "voiceText",
        "type": "voice",
        "text": "{{voiceText}}",
        "voice": "{{voiceName}}",
        "model": "{{voiceModel}}",
        "start": 0,
        "extra-time": 0.4
      }
    ]
  }
}
